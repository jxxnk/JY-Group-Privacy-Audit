# Copy to .env only for local lab use. Never commit .env.
JY_LAB_ENV=local
JY_OUTPUT_DIR=evidence/sanitized
JY_LOG_LEVEL=INFO
JY_COLLECTION_TIMEOUT_SECONDS=30
JY_REDACT_OUTPUT=true

# Use documentation-only TEST-NET ranges in committed examples.
JY_HOLDINGS_SUBNET=192.0.2.0/28
JY_INDUSTRIAL_SUBNET=198.51.100.0/28
JY_SERVICE_SUBNET=203.0.113.0/28

# Do not put passwords, tokens, private keys or real host data in this file.
